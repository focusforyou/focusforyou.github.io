rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function self(uid) { return request.auth != null && request.auth.uid == uid; }
  function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
  function unlocked(uid) { return !exists(/databases/$(database)/documents/deletions/$(uid)); }
  function locked(uid) { return exists(/databases/$(database)/documents/deletions/$(uid)); }
  function verified() { return request.auth != null && request.auth.uid != 'focusforyou' && request.auth.token.email_verified == true; }
  function active() { return verified() && unlocked(request.auth.uid) && (request.auth.token.email == 'efeozbilgin550@gmail.com' || !exists(/databases/$(database)/documents/appBans/$(request.auth.uid))); }
  function admin() { return verified() && unlocked(request.auth.uid) && request.auth.token.email == 'efeozbilgin550@gmail.com'; }
  function availableHandle(handle) { return handle != 'focusforyou' && (handle != 'efe' || admin()); }
  function immune(uid) { return exists(/databases/$(database)/documents/publicProfiles/$(uid)) && get(/databases/$(database)/documents/publicProfiles/$(uid)).data.username == 'efe'; }
  function room(rid) { return get(/databases/$(database)/documents/rooms/$(rid)).data; }
  function roomOpen(rid) { return room(rid).get('deleting',false) == false; }
  function leader(rid) { return request.auth != null && room(rid).ownerUid == request.auth.uid; }
  function kicked(rid,uid) {
   let receipt = get(/databases/$(database)/documents/rooms/$(rid)/kicks/$(uid));
   return receipt != null && get(/databases/$(database)/documents/rooms/$(rid)/members/$(uid)).data.joinedAt <= receipt.data.at;
  }
  function roomAllowed(rid) { return admin() || (!exists(/databases/$(database)/documents/rooms/$(rid)/bans/$(request.auth.uid)) && !kicked(rid,request.auth.uid)); }
  function member(rid) { return active() && exists(/databases/$(database)/documents/rooms/$(rid)/members/$(request.auth.uid)) && roomAllowed(rid); }
  // Read membership once: exists(member) followed by kicked()'s get(member)
  // can consume separate access calls. Ordinary allowed targets need no profile
  // lookup; protected admins use one profile get only when a sanction applies.
  // Deletion locks and membership remain mandatory for every recipient.
  function contactAllowed(from,to) { let c=get(/databases/$(database)/documents/users/$(to)/controls/$(from)); return c == null || c.data.blocked == false; }
  function nudgeAllowed(from,to) { let c=get(/databases/$(database)/documents/users/$(to)/controls/$(from)); return c == null || (c.data.blocked == false && c.data.muted == false); }
  function nudgeTarget(rid,uid) {
   let targetMember = get(/databases/$(database)/documents/rooms/$(rid)/members/$(uid)).data;
   let targetKick = get(/databases/$(database)/documents/rooms/$(rid)/kicks/$(uid));
   return targetMember is map && unlocked(uid)
    && ((!exists(/databases/$(database)/documents/appBans/$(uid))
     && !exists(/databases/$(database)/documents/rooms/$(rid)/bans/$(uid))
     && (targetKick == null || targetMember.joinedAt > targetKick.data.at))
     || get(/databases/$(database)/documents/publicProfiles/$(uid)).data.username == 'efe');
  }
  function nudgeHeartbeat(rid) {
   let after = getAfter(/databases/$(database)/documents/rooms/$(rid)/members/$(request.auth.uid)).data;
   // presenceAt must equal this request's server timestamp. Thus the same
   // atomic request must include a member update authorized by that path's
   // independent active()/roomAllowed() rule; an old heartbeat cannot attest it.
   return after.uid == request.auth.uid && after.presenceAt == request.time;
  }
  function roomManager(rid) { return active() && (admin() || (leader(rid) && roomAllowed(rid))); }
  function moderator(rid) { return active() && (admin() || (roomAllowed(rid) && (leader(rid)
   || get(/databases/$(database)/documents/rooms/$(rid)/members/$(request.auth.uid)).data.get('role','member') == 'moderator'))); }
  function sanctionable(rid,uid) {
   let target = get(/databases/$(database)/documents/rooms/$(rid)/members/$(uid)).data;
   return target is map && (roomManager(rid) || (uid != room(rid).ownerUid && target.get('role','member') != 'moderator'));
  }
  function quietValid(m) { return !('quietUntil' in m) || (m.quietUntil is int && m.quietUntil >= 0 && m.quietUntil <= request.time.toMillis() + 86400000); }
  function showcaseValid(s) {
   return s is map && s.keys().hasOnly(['bio','showHours','seconds','badges']) && s.bio is string && s.bio.size() <= 160
    && s.showHours is bool && s.seconds is number && s.seconds >= 0 && s.seconds <= 315360000
    && s.badges is list && s.badges.size() <= 3 && s.badges.toSet().size() == s.badges.size()
    && s.badges.hasOnly(['first','ten','fifty','hundred','fivehundred','thousand'])
    && (!('first' in s.badges) || s.seconds >= 3600) && (!('ten' in s.badges) || s.seconds >= 36000)
    && (!('fifty' in s.badges) || s.seconds >= 180000) && (!('hundred' in s.badges) || s.seconds >= 360000)
    && (!('fivehundred' in s.badges) || s.seconds >= 1800000) && (!('thousand' in s.badges) || s.seconds >= 3600000);
  }
  function roomExtrasValid(r) {
   return r.get('theme','night') in ['night','aurora','ocean','sunset']
    && r.get('previewUids',[]) is list && r.get('previewUids',[]).size() <= 4
    && r.get('previewUids',[]).toSet().size() == r.get('previewUids',[]).size();
  }
  function ownPreview(rid,before,after) {
   let old = before.get('previewUids',[]);
   let next = after.get('previewUids',[]);
   return old is list
    && next.toSet().difference(old.toSet()).hasOnly([request.auth.uid])
    && old.toSet().difference(next.toSet()).hasOnly([request.auth.uid])
    && ((member(rid) && roomOpen(rid))
     || (locked(request.auth.uid) && next.toSet().difference(old.toSet()).size() == 0));
  }
  function roomUpdateAllowed(rid,before,after) {
   let changed = after.diff(before).affectedKeys();
   // Preview authorization is evaluated once, including for admin updates.
   // Other updates never need membership/preview authorization.
   return roomExtrasValid(after) && (changed.hasAny(['previewUids'])
    ? ((changed.hasOnly(['previewUids']) || admin()) && ownPreview(rid,before,after))
    : (admin()
     || (changed.hasOnly(['theme']) && roomManager(rid) && roomOpen(rid))
     || (changed.hasOnly(['deleting']) && after.deleting == true
      && !(rid in ['YKS','LGS','TUS']) && leader(rid) && active())
     || (changed.hasOnly(['ownerUid']) && after.ownerUid != request.auth.uid
      && leader(rid) && locked(request.auth.uid)
      && exists(/databases/$(database)/documents/rooms/$(rid)/members/$(after.ownerUid)))));
  }
  function joiningAllowed(rid) { return admin() || (!exists(/databases/$(database)/documents/rooms/$(rid)/bans/$(request.auth.uid)) && (!exists(/databases/$(database)/documents/rooms/$(rid)/kicks/$(request.auth.uid)) || get(/databases/$(database)/documents/rooms/$(rid)/kicks/$(request.auth.uid)).data.at < request.time)); }
  function validModeration(m) { return m.keys().hasOnly(['by','at']) && m.by == request.auth.uid && m.at == request.time; }
  function reactionChange(before,after,key) {
   let previous = before.get(key,[]);
   let next = after.get(key,[]);
   return previous is list && next is list && next.size() <= 500 && next.toSet().size() == next.size()
    && next.toSet().difference(previous.toSet()).hasOnly([request.auth.uid])
    && previous.toSet().difference(next.toSet()).hasOnly([request.auth.uid]);
  }
  function validReactionUpdate(before,after) {
   return before is map && after is map && after.keys().hasOnly(['👍','❤️','🔥','👏','🎯','💡','🎉'])
    && reactionChange(before,after,'👍') && reactionChange(before,after,'❤️')
    && reactionChange(before,after,'🔥') && reactionChange(before,after,'👏')
    && reactionChange(before,after,'🎯') && reactionChange(before,after,'💡') && reactionChange(before,after,'🎉');
  }
  function validTimer(t) {
   return t is map && t.keys().hasOnly(['phase','running','left','total','worked','roomWorked','focus','rest','rounds'])
    && t.phase in ['focus','break'] && t.running is bool
    && t.left is number && t.left >= 0 && t.left <= 10800
    && t.total is number && t.total >= 60 && t.total <= 10800
    && t.worked is number && t.worked >= 0 && t.worked <= 315360000
    && t.roomWorked is number && t.roomWorked >= 0 && t.roomWorked <= 315360000
    && t.focus is number && t.focus >= 60 && t.focus <= 10800
    && t.rest is number && t.rest >= 60 && t.rest <= 3600
    && t.rounds is int && t.rounds >= 0 && t.rounds <= 100000;
  }
  function ownedStyle(uid,key,value,baseline) {
   return value == baseline || (exists(/databases/$(database)/documents/entitlements/$(uid))
    && get(/databases/$(database)/documents/entitlements/$(uid)).data.get(key,[]) is list
    && value in get(/databases/$(database)/documents/entitlements/$(uid)).data.get(key,[]));
  }
  function validCosmetics(c,uid) {
   return c is map && c.keys().hasOnly(['tag','nameStyle','frame','plate','font'])
    && c.get('font','default') in ['default','fredoka','cinzel','space-mono','bungee','pacifico','chelaone','orbitron']
    && c.tag is string && (c.tag in ['none','doctor'] || c.tag.matches('custom:.{1,24}'))
    && c.nameStyle in ['plain','gold','ruby','ice','violet','emerald'] && c.frame in ['none','gold','ruby','ice','violet','emerald','ember','lunar','sakura','cyber','abyss','robot-gold','robot-silver','pulse','robot-duo'] && c.plate in ['none','gold','ruby','ice','violet','emerald','ember','lunar','sakura','cyber','abyss','robot-gold','robot-silver']
    && (admin() || ((c.tag == 'none' || (c.tag != 'doctor' && ownedStyle(uid,'tags',c.tag,'none')))
     && ownedStyle(uid,'fonts',c.get('font','default'),'default') && ownedStyle(uid,'nameStyles',c.nameStyle,'plain') && ownedStyle(uid,'frames',c.frame,'none') && ownedStyle(uid,'plates',c.plate,'none')));
  }
  function itemInfo(id) { let value={'name:gold':'gold','name:ruby':'ruby','name:ice':'ice','name:violet':'violet','name:emerald':'emerald','frame:gold':'gold','frame:ruby':'ruby','frame:ice':'ice','frame:violet':'violet','frame:emerald':'emerald','plate:gold':'gold','plate:ruby':'ruby','plate:ice':'ice','plate:violet':'violet','plate:emerald':'emerald','font:fredoka':'fredoka','font:cinzel':'cinzel','font:space-mono':'space-mono','font:bungee':'bungee','font:pacifico':'pacifico','font:chelaone':'chelaone','font:orbitron':'orbitron','frame:ember':'ember','plate:ember':'ember','frame:lunar':'lunar','plate:lunar':'lunar','frame:sakura':'sakura','plate:sakura':'sakura','frame:cyber':'cyber','plate:cyber':'cyber','frame:abyss':'abyss','plate:abyss':'abyss','frame:robot-gold':'robot-gold','plate:robot-gold':'robot-gold','frame:robot-silver':'robot-silver','plate:robot-silver':'robot-silver','frame:pulse':'pulse','frame:robot-duo':'robot-duo'}.get(id,''); return [value == '' ? '' : (id.matches('font:.*') ? 'fonts' : id.matches('name:.*') ? 'nameStyles' : id.matches('frame:.*') ? 'frames' : 'plates'),value]; }
  function itemCost(id) { return id in ['name:gold','name:ruby','name:ice','name:violet','name:emerald'] ? 36000 : id in ['frame:gold','frame:ruby','frame:ice','frame:violet','frame:emerald'] ? 72000 : id in ['plate:gold','plate:ruby','plate:ice','plate:violet','plate:emerald'] ? 54000 : id in ['font:fredoka','font:cinzel','font:space-mono','font:bungee','font:pacifico','font:chelaone','font:orbitron'] ? 18000 : id in ['frame:ember','frame:lunar','frame:sakura','frame:cyber','frame:abyss'] ? 108000 : id in ['plate:ember','plate:lunar','plate:sakura','plate:cyber','plate:abyss','plate:robot-gold','plate:robot-silver'] ? 90000 : id in ['frame:robot-gold','frame:robot-silver','frame:pulse','frame:robot-duo'] ? 180000 : 0; }
  function validOwned(e) {
   return e is map && e.keys().hasOnly(['nameStyles','frames','plates','tags','fonts'])
    && e.get('fonts',[]) is list && e.get('fonts',[]).size() <= 7 && e.get('fonts',[]).hasOnly(['fredoka','cinzel','space-mono','bungee','pacifico','chelaone','orbitron'])
    && e.get('nameStyles',[]) is list && e.get('nameStyles',[]).size() <= 6 && e.get('nameStyles',[]).hasOnly(['plain','gold','ruby','ice','violet','emerald'])
    && e.get('frames',[]) is list && e.get('frames',[]).size() <= 15 && e.get('frames',[]).hasOnly(['none','gold','ruby','ice','violet','emerald','ember','lunar','sakura','cyber','abyss','robot-gold','robot-silver','pulse','robot-duo'])
    && e.get('plates',[]) is list && e.get('plates',[]).size() <= 13 && e.get('plates',[]).hasOnly(['none','gold','ruby','ice','violet','emerald','ember','lunar','sakura','cyber','abyss','robot-gold','robot-silver'])
    && e.get('tags',[]) is list && e.get('tags',[]).size() <= 30;
  }
  function itemGrant(before,after,key,info) {
   let old = before.get(key,[]);
   let next = after.get(key,[]);
   return old is list && next is list && (key != info[0] ? next == old
    : (!(info[1] in old) && next.size() == old.size() + 1 && next.toSet().size() == next.size()
     && next.toSet().difference(old.toSet()).hasOnly([info[1]]) && old.toSet().difference(next.toSet()).size() == 0));
  }
  function purchaseGrant(before,after,id) {
   let info = itemInfo(id);
   return info[0] != '' && validOwned(after) && before.get('tags',[]) == after.get('tags',[])
    && itemGrant(before,after,'fonts',info) && itemGrant(before,after,'nameStyles',info) && itemGrant(before,after,'frames',info) && itemGrant(before,after,'plates',info);
  }
  function previousOwned(uid) {
   return exists(/databases/$(database)/documents/entitlements/$(uid)) ? get(/databases/$(database)/documents/entitlements/$(uid)).data : {};
  }
  function validWallet(w) {
   return w.keys().hasOnly(['earnedSeconds','spentSeconds','running','checkpoint','lastPurchase'])
    && w.earnedSeconds is int && w.earnedSeconds >= 0 && w.earnedSeconds <= 3153600000
    && w.spentSeconds is int && w.spentSeconds >= 0 && w.spentSeconds <= w.earnedSeconds
    && w.running is bool && w.checkpoint is timestamp && w.checkpoint <= request.time
    && w.lastPurchase is string && (w.lastPurchase == '' || itemCost(w.lastPurchase) > 0);
  }
  function paidGrant(uid,before,after) {
   let oldWallet = get(/databases/$(database)/documents/wallets/$(uid)).data;
   let nextWallet = getAfter(/databases/$(database)/documents/wallets/$(uid)).data;
   return nextWallet.spentSeconds == oldWallet.spentSeconds + itemCost(nextWallet.lastPurchase)
    && nextWallet.earnedSeconds == oldWallet.earnedSeconds && nextWallet.running == oldWallet.running && nextWallet.checkpoint == oldWallet.checkpoint
    && purchaseGrant(before,after,nextWallet.lastPurchase);
  }
  function validImage(value) { return value is string && (value == '' || (value.size() <= 40000 && value.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}')) || (value.size() <= 180000 && value.matches('data:image/gif;base64,R0lGOD(dh|lh)[A-Za-z0-9+/]+={0,2}'))); }
  function validPublic(p,uid) {
   return p.keys().hasOnly(['uid','username','name','photo','exam','cosmetics','showcase','banner'])
    && p.uid == uid && p.username is string && p.username.matches('[a-z0-9_]{3,24}')
    && availableHandle(p.username)
    && getAfter(/databases/$(database)/documents/usernames/$(p.username)).data.uid == uid
    && p.name is string && p.name.size() >= 1 && p.name.size() <= 30
    && (validImage(p.photo) || (p.photo is string && p.photo.size() < 1500 && p.photo.matches('https://lh[0-9]+[.]googleusercontent[.]com/.*')))
    && (!('banner' in p) || validImage(p.banner))
    && p.exam in ['', 'YKS','LGS','TUS','OTHER'] && validCosmetics(p.cosmetics,uid)
    && (!('showcase' in p) || showcaseValid(p.showcase));
  }
  match /publicProfiles/{uid} {
   allow read: if active() || self(uid);
   allow create: if self(uid) && active() && validPublic(request.resource.data,uid);
   allow update: if self(uid) && active() && request.resource.data.username == resource.data.username && validPublic(request.resource.data,uid);
   allow delete: if self(uid) && locked(uid);
  }
  match /usernames/{handle} {
   allow get: if active() || (request.auth != null && resource.data.uid == request.auth.uid) || (request.auth != null && locked(request.auth.uid) && get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username == handle);
   allow create: if active() && handle.matches('[a-z0-9_]{3,24}') && availableHandle(handle)
    && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
    && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username == handle;
   allow update: if active() && resource.data.uid == request.auth.uid && request.resource.data == resource.data;
   allow delete: if request.auth != null && resource.data.uid == request.auth.uid && locked(request.auth.uid);
  }
  match /entitlements/{uid} {
   allow get: if self(uid) || admin();
   allow create, update: if validOwned(request.resource.data) && ((admin() && unlocked(uid) && exists(/databases/$(database)/documents/publicProfiles/$(uid)))
    || (self(uid) && active() && paidGrant(uid,previousOwned(uid),request.resource.data)));
   allow delete: if self(uid) && locked(uid);
  }
  match /wallets/{uid} {
   allow get: if self(uid);
   allow create: if self(uid) && active() && validWallet(request.resource.data)
    && request.resource.data.earnedSeconds == 0 && request.resource.data.spentSeconds == 0
    && request.resource.data.lastPurchase == '' && request.resource.data.checkpoint == request.time;
   allow update: if self(uid) && active() && validWallet(request.resource.data)
    && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['earnedSeconds','running','checkpoint'])
     && request.resource.data.checkpoint == request.time && request.resource.data.earnedSeconds >= resource.data.earnedSeconds
     && request.resource.data.earnedSeconds - resource.data.earnedSeconds <= (resource.data.running ? (request.time.toMillis() - resource.data.checkpoint.toMillis()) / 1000 : 0)
     && request.resource.data.earnedSeconds - resource.data.earnedSeconds <= 60)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spentSeconds','lastPurchase'])
     && request.resource.data.spentSeconds == resource.data.spentSeconds + itemCost(request.resource.data.lastPurchase)
     && purchaseGrant(previousOwned(uid),getAfter(/databases/$(database)/documents/entitlements/$(uid)).data,request.resource.data.lastPurchase)));
   allow delete: if self(uid) && locked(uid);
  }
  match /users/{uid}/controls/{target} {
   allow read: if self(uid);
   allow create, update: if self(uid) && active() && target != uid && target.size() <= 128
    && request.resource.data.keys().hasOnly(['blocked','muted']) && request.resource.data.blocked is bool && request.resource.data.muted is bool;
   allow delete: if self(uid);
  }
  match /friendships/{id} {
   allow get: if request.auth != null && (id.matches(request.auth.uid + '_.*') || id.matches('.*_' + request.auth.uid));
   allow list: if request.auth != null && request.auth.uid in resource.data.uids;
   allow create: if active() && request.resource.data.keys().hasOnly(['uids','from','to','state'])
    && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid && contactAllowed(request.auth.uid,request.resource.data.to)
    && request.resource.data.to is string && request.resource.data.uids is list && request.resource.data.uids.size() == 2
    && request.resource.data.uids.hasAll([request.resource.data.from,request.resource.data.to])
    && (id == request.resource.data.from + '_' + request.resource.data.to || id == request.resource.data.to + '_' + request.resource.data.from)
    && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.to))
    && unlocked(request.resource.data.to)
    && !exists(/databases/$(database)/documents/appBans/$(request.resource.data.to))
    && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
    && request.resource.data.state == 'pending';
   allow update: if active() && contactAllowed(request.auth.uid,resource.data.from) && resource.data.to == request.auth.uid && resource.data.state == 'pending'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']) && request.resource.data.state == 'accepted';
   allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
  }
  match /roomInvites/{id} {
   allow get: if request.auth != null && (id.matches('.*_' + request.auth.uid) || resource.data.from == request.auth.uid);
   allow list: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
   allow create, update: if active() && request.resource.data.keys().hasOnly(['from','to','roomId'])
    && request.resource.data.from == request.auth.uid && request.resource.data.to is string
    && contactAllowed(request.auth.uid,request.resource.data.to) && id == request.resource.data.roomId + '_' + request.resource.data.to && roomManager(request.resource.data.roomId) && roomOpen(request.resource.data.roomId)
    && unlocked(request.resource.data.to)
    && !exists(/databases/$(database)/documents/appBans/$(request.resource.data.to))
    && !exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)/bans/$(request.resource.data.to))
    && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.to));
   allow delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
  }
  match /users/{uid}/rooms/{rid} {
   allow read: if self(uid);
   allow create, update: if self(uid) && active() && joiningAllowed(rid) && request.resource.data.keys().hasOnly(['name'])
    && request.resource.data.name == room(rid).name
    && existsAfter(/databases/$(database)/documents/rooms/$(rid)/members/$(uid));
   allow delete: if self(uid) && (active() || locked(uid)) && !existsAfter(/databases/$(database)/documents/rooms/$(rid)/members/$(uid));
  }
  match /users/{uid}/roomProofs/{rid} {
   allow read: if self(uid);
   allow create, update: if self(uid) && active() && joiningAllowed(rid) && roomOpen(rid) && request.resource.data.keys().hasOnly(['hash','at'])
    && request.resource.data.at == request.time
    && request.resource.data.hash == get(/databases/$(database)/documents/rooms/$(rid)/secrets/password).data.hash;
   allow delete: if self(uid);
  }
  match /rooms/{rid} {
   allow read: if active() || (request.auth != null && locked(request.auth.uid));
   allow create: if active() && request.resource.data.keys().hasOnly(['name','ownerUid','locked','salt','exam','unlimited','createdAt','theme','previewUids'])
    && roomExtrasValid(request.resource.data) && request.resource.data.get('previewUids',[]).size() == 0
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
    && (request.resource.data.ownerUid == request.auth.uid || (admin() && rid in ['YKS','LGS','TUS'] && request.resource.data.ownerUid == 'focusforyou')) && request.resource.data.locked is bool
    && request.resource.data.salt is string && request.resource.data.salt.size() <= 64
    && (!request.resource.data.keys().hasAny(['unlimited']) || request.resource.data.unlimited is bool) && request.resource.data.createdAt == request.time
    && ((rid.matches('[1-9][0-9]{7}') && request.resource.data.exam == '')
      || (admin() && rid in ['YKS','LGS','TUS'] && request.resource.data.exam == rid && request.resource.data.locked == false));
   // A deleting leader transfers a room to an existing member before losing Auth.
   allow update: if request.auth != null && roomUpdateAllowed(rid,resource.data,request.resource.data);
   allow delete: if admin() || (resource.data.ownerUid == request.auth.uid && active()) || (resource.data.ownerUid == request.auth.uid && locked(request.auth.uid));
   match /secrets/{secret} {
    allow get: if roomManager(rid) || (leader(rid) && locked(request.auth.uid));
    allow create: if active() && secret == 'password' && getAfter(/databases/$(database)/documents/rooms/$(rid)).data.ownerUid == request.auth.uid
     && getAfter(/databases/$(database)/documents/rooms/$(rid)).data.get('deleting',false) == false
     && request.resource.data.keys().hasOnly(['hash']) && request.resource.data.hash.matches('[a-f0-9]{64}');
    allow delete: if admin() || (leader(rid) && active()) || (leader(rid) && locked(request.auth.uid));
   }
   match /members/{uid} {
    allow get: if self(uid) || member(rid) || moderator(rid) || (leader(rid) && locked(request.auth.uid));
    allow list: if member(rid) || moderator(rid) || (leader(rid) && locked(request.auth.uid));
    allow create: if self(uid) && active() && joiningAllowed(rid) && roomOpen(rid)
     && !locked(room(rid).ownerUid)
     && existsAfter(/databases/$(database)/documents/users/$(uid)/rooms/$(rid))
     && (admin() || room(rid).locked == false || leader(rid)
       || exists(/databases/$(database)/documents/roomInvites/$(rid + '_' + uid))
       || (get(/databases/$(database)/documents/users/$(uid)/roomProofs/$(rid)).data.at > request.time - duration.value(5,'m')))
     && request.resource.data.keys().hasOnly(['uid','joinedAt','presenceAt','online','timer','role','quietUntil'])
     && request.resource.data.get('role','member') == 'member' && quietValid(request.resource.data)
     && request.resource.data.uid == uid && request.resource.data.joinedAt == request.time
     && request.resource.data.presenceAt == request.time && request.resource.data.online is bool && validTimer(request.resource.data.timer);
    allow update: if roomOpen(rid) && quietValid(request.resource.data) && request.resource.data.uid == uid
     && ((self(uid) && active()
     && ((roomAllowed(rid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timer','presenceAt','online','quietUntil']))
       || (joiningAllowed(rid) && kicked(rid,uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedAt','timer','presenceAt','online','quietUntil'])
        && request.resource.data.joinedAt == request.time
        && request.resource.data.timer.roomWorked >= resource.data.timer.roomWorked))
     && request.resource.data.presenceAt == request.time && request.resource.data.online is bool && validTimer(request.resource.data.timer))
     || (self(uid) && active() && roomAllowed(rid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quietUntil']))
     || (roomManager(rid) && uid != request.auth.uid && uid != room(rid).ownerUid && !immune(uid) && unlocked(uid)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) && request.resource.data.role in ['member','moderator']));
    allow delete: if admin() || (self(uid) && active()) || (self(uid) && locked(uid))
     || (((moderator(rid) && sanctionable(rid,uid)) || (leader(rid) && locked(request.auth.uid)))
       && (!immune(uid) || !existsAfter(/databases/$(database)/documents/rooms/$(rid))));
   }
   match /studyGoals/{gid} {
    allow read: if member(rid) || (leader(rid) && locked(request.auth.uid));
    allow create, update: if roomManager(rid) && roomOpen(rid) && gid == 'current'
     && request.resource.data.keys().hasOnly(['title','targetSeconds','ownerUid','startedAt','endsAt','goalId'])
     && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
     && request.resource.data.targetSeconds is int && request.resource.data.targetSeconds >= 3600 && request.resource.data.targetSeconds <= 3600000
     && request.resource.data.ownerUid == request.auth.uid && request.resource.data.startedAt == request.time
     && request.resource.data.goalId is string && request.resource.data.goalId.matches('[a-f0-9]{20}')
     && request.resource.data.endsAt is number && request.resource.data.endsAt > request.time.toMillis() && request.resource.data.endsAt <= request.time.toMillis()+604800000;
    allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && locked(request.auth.uid)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']) && request.resource.data.ownerUid != request.auth.uid
     && exists(/databases/$(database)/documents/rooms/$(rid)/members/$(request.resource.data.ownerUid));
    allow delete: if roomManager(rid) || (leader(rid) && locked(request.auth.uid)) || (request.auth != null && resource.data.ownerUid == request.auth.uid && locked(request.auth.uid));
    match /contributions/{uid} {
     allow read: if member(rid) || self(uid) || (leader(rid) && locked(request.auth.uid)) || (request.auth != null && locked(request.auth.uid) && get(/databases/$(database)/documents/rooms/$(rid)/studyGoals/$(gid)).data.ownerUid == request.auth.uid);
     allow create, update: if member(rid) && self(uid) && roomOpen(rid)
      && request.resource.data.keys().hasOnly(['uid','goalId','seconds','updatedAt']) && request.resource.data.uid == uid
      && request.resource.data.goalId == get(/databases/$(database)/documents/rooms/$(rid)/studyGoals/$(gid)).data.goalId
      && get(/databases/$(database)/documents/rooms/$(rid)/studyGoals/$(gid)).data.endsAt > request.time.toMillis()
      && request.resource.data.updatedAt == request.time && request.resource.data.seconds is int && request.resource.data.seconds >= 0 && request.resource.data.seconds <= 604800
      && (resource == null || request.resource.data.goalId != resource.data.goalId || request.resource.data.seconds >= resource.data.seconds);
     allow delete: if self(uid) || roomManager(rid) || (leader(rid) && locked(request.auth.uid)) || (request.auth != null && locked(request.auth.uid) && get(/databases/$(database)/documents/rooms/$(rid)/studyGoals/$(gid)).data.ownerUid == request.auth.uid);
    }
   }
   match /studySessions/{sid} {
    allow read: if member(rid) || (request.auth != null && resource.data.ownerUid == request.auth.uid) || (leader(rid) && locked(request.auth.uid));
    allow create: if member(rid) && roomOpen(rid) && sid.matches('[a-f0-9]{20}')
     && request.resource.data.keys().hasOnly(['title','ownerUid','focus','rest','status','startedAt','createdAt'])
     && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time
     && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
     && request.resource.data.focus is int && request.resource.data.focus >= 60 && request.resource.data.focus <= 10800
     && request.resource.data.rest is int && request.resource.data.rest >= 60 && request.resource.data.rest <= 3600
     && request.resource.data.status == 'ready' && request.resource.data.startedAt == 0;
    allow update: if member(rid) && roomOpen(rid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','startedAt'])
     && ((resource.data.ownerUid == request.auth.uid && request.resource.data.status in ['ready','running','closed']
      && request.resource.data.startedAt is number && request.resource.data.startedAt >= 0 && request.resource.data.startedAt <= request.time.toMillis()+10000)
      || (roomManager(rid) && request.resource.data.status == 'closed' && request.resource.data.startedAt == resource.data.startedAt));
    allow delete: if roomManager(rid) || (request.auth != null && resource.data.ownerUid == request.auth.uid) || (leader(rid) && locked(request.auth.uid));
    match /participants/{uid} {
     allow read: if member(rid) || self(uid) || (locked(request.auth.uid) && get(/databases/$(database)/documents/rooms/$(rid)/studySessions/$(sid)).data.ownerUid == request.auth.uid) || (leader(rid) && locked(request.auth.uid));
     allow create, update: if member(rid) && owner(uid) && roomOpen(rid)
      && get(/databases/$(database)/documents/rooms/$(rid)/studySessions/$(sid)).data.status != 'closed'
      && request.resource.data.keys().hasOnly(['uid','joinedAt']) && request.resource.data.uid == uid && request.resource.data.joinedAt == request.time;
     allow delete: if self(uid) || roomManager(rid) || (leader(rid) && locked(request.auth.uid)) || (locked(request.auth.uid) && get(/databases/$(database)/documents/rooms/$(rid)/studySessions/$(sid)).data.ownerUid == request.auth.uid);
    }
   }
   match /studyEvents/{eid} {
    allow read: if member(rid) || (request.auth != null && resource.data.ownerUid == request.auth.uid) || (leader(rid) && locked(request.auth.uid));
    allow create: if member(rid) && roomOpen(rid) && eid.matches('[a-f0-9]{20}')
     && request.resource.data.keys().hasOnly(['title','ownerUid','startsAt','cancelled','createdAt'])
     && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time
     && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
     && request.resource.data.startsAt is number && request.resource.data.startsAt >= request.time.toMillis()+60000 && request.resource.data.startsAt <= request.time.toMillis()+7776000000
     && request.resource.data.cancelled == false;
    allow update: if member(rid) && roomOpen(rid) && (resource.data.ownerUid == request.auth.uid || roomManager(rid))
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled']) && request.resource.data.cancelled == true;
    allow delete: if roomManager(rid) || (request.auth != null && resource.data.ownerUid == request.auth.uid) || (leader(rid) && locked(request.auth.uid));
    match /attendees/{uid} {
     allow read: if member(rid) || self(uid) || (locked(request.auth.uid) && get(/databases/$(database)/documents/rooms/$(rid)/studyEvents/$(eid)).data.ownerUid == request.auth.uid) || (leader(rid) && locked(request.auth.uid));
     allow create, update: if member(rid) && owner(uid) && roomOpen(rid)
      && get(/databases/$(database)/documents/rooms/$(rid)/studyEvents/$(eid)).data.cancelled == false
      && request.resource.data.keys().hasOnly(['uid','joinedAt']) && request.resource.data.uid == uid && request.resource.data.joinedAt == request.time;
     allow delete: if self(uid) || roomManager(rid) || (leader(rid) && locked(request.auth.uid)) || (locked(request.auth.uid) && get(/databases/$(database)/documents/rooms/$(rid)/studyEvents/$(eid)).data.ownerUid == request.auth.uid);
    }
   }
   match /messages/{message} {
    // Own-author queries remain available for export and account deletion.
    allow read: if member(rid) || moderator(rid) || (request.auth != null && resource.data.uid == request.auth.uid);
    allow create: if active() && member(rid) && roomOpen(rid) && request.resource.data.keys().hasOnly(['uid','text','image','time','replyTo','reactions','question','solved','pinned','threadId'])
     && request.resource.data.get('question',false) is bool && request.resource.data.get('solved',false) == false
     && request.resource.data.get('pinned',false) == false
     && request.resource.data.uid == request.auth.uid && message.matches('[A-Z2-9]{20}')
     && request.resource.data.time == request.time && request.resource.data.text is string && request.resource.data.text.size() <= 2000
     && request.resource.data.image is string && request.resource.data.image.size() <= 450000
     && (request.resource.data.image == '' || request.resource.data.image.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}'))
     && (request.resource.data.text.size() > 0 || request.resource.data.image.size() > 0)
     && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is map && request.resource.data.replyTo.keys().hasOnly(['id','sender','text']) && request.resource.data.replyTo.id is string && request.resource.data.replyTo.id.matches('[A-Z2-9]{20}') && request.resource.data.replyTo.sender is string && request.resource.data.replyTo.sender.size() <= 50 && request.resource.data.replyTo.text is string && request.resource.data.replyTo.text.size() <= 500 && contactAllowed(request.auth.uid,get(/databases/$(database)/documents/rooms/$(rid)/messages/$(request.resource.data.replyTo.id)).data.uid)))
     && (!('threadId' in request.resource.data) || (request.resource.data.threadId is string && request.resource.data.threadId.matches('[A-Z2-9]{20}')
      && get(/databases/$(database)/documents/rooms/$(rid)/messages/$(request.resource.data.threadId)).data.get('question',false) == true
      && contactAllowed(request.auth.uid,get(/databases/$(database)/documents/rooms/$(rid)/messages/$(request.resource.data.threadId)).data.uid)))
     && (!('reactions' in request.resource.data) || (request.resource.data.reactions is map && request.resource.data.reactions.size() == 0));
    allow update: if active() && member(rid) && roomOpen(rid)
     && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
      && request.resource.data.pinned is bool && moderator(rid))
      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      && validReactionUpdate(resource.data.get('reactions',{}),request.resource.data.reactions))
      || (resource.data.get('question',false) == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solved'])
       && request.resource.data.solved is bool && (resource.data.uid == request.auth.uid || moderator(rid))));
    allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || moderator(rid) || (leader(rid) && locked(request.auth.uid));
   }
   match /bans/{uid} {
    allow get: if self(uid) || moderator(rid) || (leader(rid) && locked(request.auth.uid));
    allow list: if moderator(rid) || (leader(rid) && locked(request.auth.uid));
    allow create, update: if moderator(rid) && uid != request.auth.uid && !locked(uid) && !immune(uid)
     && sanctionable(rid,uid) && validModeration(request.resource.data);
    allow delete: if (moderator(rid) && sanctionable(rid,uid)) || roomManager(rid) || (self(uid) && locked(uid)) || (leader(rid) && locked(request.auth.uid));
   }
   match /kicks/{uid} {
    allow get: if self(uid) || moderator(rid) || (leader(rid) && locked(request.auth.uid));
    allow list: if moderator(rid) || (leader(rid) && locked(request.auth.uid));
    allow create, update: if moderator(rid) && uid != request.auth.uid && !locked(uid) && !immune(uid)
     && sanctionable(rid,uid) && validModeration(request.resource.data);
    allow delete: if (moderator(rid) && sanctionable(rid,uid)) || roomManager(rid) || (self(uid) && locked(uid)) || (leader(rid) && locked(request.auth.uid));
   }
   match /nudges/{uid} {
    // Sender get uses at most ten document access calls (nine paths). Worker checks
    // the sender's own membership and sanctions separately before FCM.
    allow get: if self(uid) || (active() && resource.data.from == request.auth.uid
     && roomOpen(rid) && nudgeAllowed(request.auth.uid,uid) && nudgeTarget(rid,uid));
    allow list: if moderator(rid) || (leader(rid) && locked(request.auth.uid));
    // The heartbeat member write independently enforces active() and roomAllowed().
    // Repeating active() here would waste two access calls in this batch operation.
    allow create, update: if verified() && nudgeHeartbeat(rid) && roomOpen(rid) && uid != request.auth.uid
     && request.resource.data.keys().hasOnly(['from','to','at']) && request.resource.data.from == request.auth.uid
     && request.resource.data.to == uid && request.resource.data.at == request.time
     && nudgeAllowed(request.auth.uid,uid) && nudgeTarget(rid,uid)
     && (resource == null || resource.data.at < request.time - duration.value(10,'s'));
    allow delete: if moderator(rid) || (leader(rid) && locked(request.auth.uid));
   }
  }
  match /{parent=**}/studyGoals/{id} { allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid; allow delete: if request.auth != null && locked(request.auth.uid) && resource.data.ownerUid == request.auth.uid; }
  match /{parent=**}/studySessions/{id} { allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid; allow delete: if request.auth != null && locked(request.auth.uid) && resource.data.ownerUid == request.auth.uid; }
  match /{parent=**}/studyEvents/{id} { allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid; allow delete: if request.auth != null && locked(request.auth.uid) && resource.data.ownerUid == request.auth.uid; }
  match /{parent=**}/participants/{id} { allow read: if request.auth != null && resource.data.uid == request.auth.uid; allow delete: if request.auth != null && locked(request.auth.uid) && resource.data.uid == request.auth.uid; }
  match /{parent=**}/attendees/{id} { allow read: if request.auth != null && resource.data.uid == request.auth.uid; allow delete: if request.auth != null && locked(request.auth.uid) && resource.data.uid == request.auth.uid; }
  match /{parent=**}/contributions/{id} { allow read: if request.auth != null && resource.data.uid == request.auth.uid; allow delete: if request.auth != null && locked(request.auth.uid) && resource.data.uid == request.auth.uid; }
  match /appBans/{uid} {
   allow get: if self(uid) || (admin() && unlocked(request.auth.uid));
   allow list: if admin() && unlocked(request.auth.uid);
   allow create, update: if admin() && unlocked(request.auth.uid) && uid != request.auth.uid && !locked(uid) && !immune(uid)
    && exists(/databases/$(database)/documents/publicProfiles/$(uid)) && validModeration(request.resource.data);
   allow delete: if (admin() && unlocked(request.auth.uid) && !immune(uid)) || (self(uid) && locked(uid));
  }
  // A deleting user can remove own messages even if an old room root/bookmark is missing.
  match /{parent=**}/messages/{message} {
   allow read, delete: if request.auth != null && locked(request.auth.uid) && resource.data.uid == request.auth.uid;
  }
  match /{parent=**}/nudges/{nudge} {
   allow read, delete: if request.auth != null && locked(request.auth.uid) && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
  }
  // Fields are timestamped JSON strings in the existing sync format.
  function field(data, key, maximum) {
   return !(key in data) || (data[key] is map
    && data[key].keys().hasAll(['value', 'at'])
    && data[key].keys().hasOnly(['value', 'at'])
    && data[key].value is string && data[key].value.size() <= maximum
    && data[key].at is timestamp && data[key].at <= request.time);
  }
  function baseline(data, key, maximum) {
   return !(key in data) || (data[key] is string && data[key].size() <= maximum);
  }
  match /deletions/{uid} {
   allow get: if self(uid);
   allow create: if self(uid)
    && request.auth.token.auth_time * 1000 > request.time.toMillis() - 300000
    && request.resource.data.keys().hasOnly(['startedAt'])
    && request.resource.data.startedAt == request.time;
   // No profile/email is retained here. Updates/deletes would permit resurrection.
  }
  match /users/{uid}/meta/{document} {
   allow read: if owner(uid) || (self(uid) && locked(uid) && document == 'main');
   allow delete: if self(uid) && locked(uid) && document == 'main';
   allow create, update: if self(uid) && active() && document == 'main'
    && request.resource.data.keys().hasOnly(['days', 'fields', 'profile'])
    && request.resource.data.days is map && request.resource.data.days.size() <= 10000
    && request.resource.data.fields is map && request.resource.data.fields.size() <= 4
    && request.resource.data.fields.keys().hasOnly(['preferences', 'tasks', 'forest', 'exam'])
    && baseline(request.resource.data.fields, 'preferences', 2048)
    && baseline(request.resource.data.fields, 'tasks', 65536)
    && baseline(request.resource.data.fields, 'forest', 4096)
    && baseline(request.resource.data.fields, 'exam', 256)
    && request.resource.data.profile is map
    && request.resource.data.profile.keys().hasOnly(['uid', 'name', 'photo'])
    && request.resource.data.profile.uid == uid
    && request.resource.data.profile.name is string && request.resource.data.profile.name.size() <= 30
    && (validImage(request.resource.data.profile.photo) || (request.resource.data.profile.photo is string && request.resource.data.profile.photo.size()<1500 && request.resource.data.profile.photo.matches('https://lh[0-9]+[.]googleusercontent[.]com/.*')));
  }
  match /users/{uid}/devices/{device} {
   allow read: if owner(uid) || (self(uid) && locked(uid));
   allow delete: if self(uid) && locked(uid);
   allow create, update: if self(uid) && active()
    && device.matches('[A-Za-z0-9_-]{8,64}')
    && request.resource.data.keys().hasOnly(['days', 'preferences', 'tasks', 'forest', 'exam'])
    && request.resource.data.days is map && request.resource.data.days.size() <= 10000
    && field(request.resource.data, 'preferences', 2048)
    && field(request.resource.data, 'tasks', 65536)
    && field(request.resource.data, 'forest', 4096)
    && field(request.resource.data, 'exam', 256);
  }
 }
}

